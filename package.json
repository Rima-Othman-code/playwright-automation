{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "Scalable Playwright + TypeScript UI & API Automation Framework for Senior QA Assessment",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=chromium --project=firefox",
    "test:api": "npx playwright test --project=api",
    "report": "npx playwright show-report reports/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
